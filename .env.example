# Copia in .env e compila i valori mancanti
DB_PATH=data/albo_sicuro.db
RETENTION_DAYS=10
POLL_SECONDS=8
LLM_CALL_DELAY=15
ALBO_URL=http://localhost:8001/api/atti
LABELS_PATH=data/labels.json
SCHEDE_PATH=data/schede_provvedimenti.json
CORRECTED_DIR=data/corrected
LAST_CHECK_FILE=data/last_check.txt

# LLM — provider principale Groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=groq/compound

# LLM — riserva Gemini (OpenAI-compatible)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-1.5-flash
